rules_version = '2';

// Copy this into Firebase console -> Firestore -> Rules, then publish.
//
// The shape it enforces:
//   * anyone signed in (students sign in anonymously) can read the class,
//     the roster, the questions and the live round
//   * only a teacher can write any of that
//   * nobody but a teacher can read the `keys` collection, which is where
//     the correct answers live. The question documents students read do not
//     contain answers at all, so opening the browser console gets them nothing
//   * a student may write exactly one response document, under their own id,
//     and only if they hold the seat for that id

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A teacher is anyone with a document in `admins` named after their UID.
    // Easiest way to get the first one: open diagnose.html and press
    // "Claim teacher access". You can also add one by hand in the console,
    // as admins / <the uid> / { anything }.
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function holdsSeat(classId, studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/seats/$(studentId))
        && get(/databases/$(database)/documents/classes/$(classId)/seats/$(studentId)).data.uid == request.auth.uid;
    }

    // The teacher list. While it is unlocked, the first person to open the
    // site can claim themselves as a teacher from the Connection check page,
    // which saves hand-copying a random anonymous ID into the console. Once
    // you press "Close the teacher list", only an existing teacher can add
    // another, so do that before you hand the link to a class.
    match /admins/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/meta/lock);
      allow update, delete: if isTeacher();
    }

    // Holds the single `lock` document described above.
    match /meta/{docId} {
      allow read: if signedIn();
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isTeacher();

      match /students/{studentId} {
        allow read: if signedIn();
        allow write: if isTeacher();
      }

      match /questions/{questionId} {
        allow read: if signedIn();
        allow write: if isTeacher();
      }

      // The answers. Teachers only, read and write.
      match /keys/{questionId} {
        allow read, write: if isTeacher();
      }

      match /live/{docId} {
        allow read: if signedIn();
        allow write: if isTeacher();
      }

      match /results/{resultId} {
        allow read: if signedIn();
        allow write: if isTeacher();
      }

      match /prizes/{prizeId} {
        allow read: if signedIn();
        allow write: if isTeacher();
      }

      // A phone claims a seat once. After that only that phone, or a teacher,
      // can change it.
      match /seats/{studentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isTeacher() || resource.data.uid == request.auth.uid;
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow write: if isTeacher();

        // Scored answers: your own document, your own id, and no editing
        // someone else's. Teachers read them all.
        match /responses/{studentId} {
          allow read: if isTeacher() || holdsSeat(classId, studentId);
          allow create, update: if holdsSeat(classId, studentId) || isTeacher();
          allow delete: if isTeacher();
        }

        // Practice answers from students who were not drawn. Same rule.
        match /shadow/{studentId} {
          allow read: if isTeacher() || holdsSeat(classId, studentId);
          allow create, update: if holdsSeat(classId, studentId) || isTeacher();
          allow delete: if isTeacher();
        }
      }
    }
  }
}
